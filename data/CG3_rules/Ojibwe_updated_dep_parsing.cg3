# This is a Constraint Grammar rules file for the Ojibwe language.

# Define to set as sentence delimeters
DELIMITERS = "<.>" "<?>" "<!>" ;

# We can define sets for common tag clusters
LIST VTA = VTA ;
LIST 3SgObvObj = 3SgObvObj ; # 3rd Singular Obviative Object
LIST 3PlObvObj = 3PlObvObj ; # 3rd Plural Obviative Object
LIST 3SgProxSubj = 3SgProxSubj ; # 3rd Singular Proximate Subject
LIST 3PlProxSubj = 3PlProxSubj ; # 3rd Plural Proximate Subject
LIST NA = NA ;
LIST ProxSg = ProxSg ;
LIST ProxPl = ProxPl ;
LIST ObvSg = ObvSg ;
LIST ObvPl = ObvPl ;

# LIST RELATION_VERB_NOUN = Dep_V_N ; 
LIST Dep_Subject = Dep_Subj_V ;
LIST Dep_Object = Dep_Obj_V ; 
LIST Dep_Adv = Dep_Adv_V ;
LIST Dep_Obl = Dep_Obl_V ;
LIST Dep_AdvMod = Dep_AdvMod_V ;
LIST Dep_Neg = Dep_Neg_V ;

LIST Dep_Demonstrative = Dep_Dem_N ; 
LIST Dep_Prep = Dep_Prep_N ;
LIST Dep_RelCl = Dep_RelCl_N;

LIST @SUBJ = @SUBJ ;
LIST @OBJ = @OBJ ;

# Groups of tags to refer to
SET AN_ARGUMENT = (3SgProxSubj) OR (3PlProxSubj) OR (3SgProxObj) OR (3PlProxObj) ;
SET INAN_ARGUMENT = (0SgSubj) OR (0PlSubj) OR (0SgObj) OR (0PlObj) ;

SET NA_NAD = (NA) OR (NAD) ;
SET NI_NID = (NI) OR (NID) ;

# TODO: rename
SET SPECIAL_LOCS = ("o'omaa") OR ("omaa") OR ("i'imaa") OR ("imaa") OR ("i'iwidi") OR ("iwidi") OR ("o'owidi") OR ("owidi") ;

SET NOMINAL = NA_NAD OR NI_NID ;
SET VERB = (VTA) OR (VAI) OR (VTI) OR (VII) OR (VAIO) ;
SET ADV = (ADVConj)  OR (ADVDisc) OR (ADVDub) OR (ADVGram) OR (ADVInter) OR (ADVLoc) OR (ADVMan) OR (ADVNeg) OR (ADVPred) OR (ADVQnt) OR (ADVTmp) OR (AVDDeg);
SET PRON = (PRONDem) OR (PRONDub) OR (PRONIndf) OR (PRONInter) OR (PRONPret) OR (PRONSim) OR (PRONPer) ;
SET PART = (PCEmph) OR (PCDisc) OR (PCAsp) ;

SET Unconditional_ADV = (ADVDisc) OR (ADVDub) OR (ADVGram) OR (ADVInter) OR (ADVLoc) OR (ADVMan) OR (ADVNeg) OR (ADVPred) OR (ADVQnt) OR (ADVTmp) OR (AVDDeg);

SECTION

### Blanket constraints (context independent)

### Select ADV readings UNCONDITIONALLY if available
# TODO: NOT CHECKED YET
# haven't added all ADV types (not sure if relevant)
SELECT:select_adv_cf TARGET Unconditional_ADV ;



SECTION

## DEV NOTE May 27: DELETED ALL OBV SG VS PL RULES - MAKE SURE CORRECT

### Verbs - Rules to handle ambiguity of verbs ###

## ANIMATE SUBJECT (VTA, VTI, VAI, VAIO)
## (Obviative forms not disambiguated - inherently ambiguous)

SELECT:animate_subj_rule_1 (3SgProxSubj) IF ((-1* NA_NAD + (ProxSg) BARRIER NOMINAL) OR (1* NA_NAD + (ProxSg) BARRIER NOMINAL)) ;

SELECT:animate_subj_rule_2 (3PlProxSubj) IF ((-1* NA_NAD + (ProxPl) BARRIER NOMINAL) OR (1* NA_NAD + (ProxPl) BARRIER NOMINAL)) ;


## ANIMATE OBJECT (VTA)
## (Obviative forms not disambiguated - inherently ambiguous)

SELECT:animate_obj_rule_1 (3SgProxObj) IF ((-1* NA_NAD + (ProxSg) BARRIER NOMINAL) OR (1* NA_NAD + (ProxSg) BARRIER NOMINAL));

SELECT:animate_obj_rule_2 (3PlProxObj) IF ((-1* NA_NAD + (ProxPl) BARRIER NOMINAL) OR (1* NA_NAD + (ProxPl) BARRIER NOMINAL));

## INANIMATE SUBJECT (VII)

SELECT:inanimate_subj_rule_1 (0SgSubj) IF ((-1* NI_NID + (Sg) BARRIER NOMINAL) OR (1* NI_NID + (Sg) BARRIER NOMINAL));

SELECT:inanimate_subj_rule_2 (0PlSubj) IF ((-1* NI_NID + (Pl) BARRIER NOMINAL) OR (1* NI_NID + (Pl) BARRIER NOMINAL));

## INANIMATE OBJECT (VTI, VAIO)

SELECT:inanimate_obj_rule_1 (0SgObj) IF ((-1* NI_NID + (Sg) BARRIER NOMINAL) OR (1* NI_NID + (Sg) BARRIER NOMINAL));

SELECT:inanimate_obj_rule_2 (0PlObj) IF ((-1* NI_NID + (Pl) BARRIER NOMINAL) OR (1* NI_NID + (Pl) BARRIER NOMINAL));



## TODO: where to put this??
# Remove VAIO tag if no NI/NID noun nearby
REMOVE:vaio_rule_1 (VAIO) IF (NOT (-1* NI_NID) OR (1* NI_NID)) ;



### Nouns - Rules to handle ambiguity of nouns ###

## NUMBER DISAMBIGUATION

## ANIMATE NOUNS

SELECT:noun_number_rule_1 NA_NAD + (ProxSg) IF ((-1* (3SgProxSubj) OR (3SgProxObj) BARRIER VERB) OR (1* (3SgProxSubj) OR (3SgProxObj) BARRIER VERB)) ;

SELECT:noun_number_rule_2 NA_NAD + (ProxPl) IF ((-1* (3PlProxSubj) OR (3PlProxObj) BARRIER VERB) OR (1* (3PlProxSubj) OR (3PlProxObj) BARRIER VERB)) ;


## INANIMATE NOUNS

SELECT:noun_number_rule_3 NI_NID + (Sg) IF ((-1* (0SgSubj) OR (0SgObj) BARRIER VERB) OR (1* (0SgSubj) OR (0SgObj) BARRIER VERB)) ;

SELECT:noun_number_rule_4 NI_NID + (Pl) IF ((-1* (0PlSubj) OR (0PlObj) BARRIER VERB) OR (1* (0PlSubj) OR (0PlObj) BARRIER VERB)) ;

## ANIMACY DISAMBIGUATION

SELECT:noun_animacy_rule_1 NA_NAD IF ((-1* AN_ARGUMENT BARRIER VERB) OR (1* AN_ARGUMENT BARRIER VERB)) (NOT -1* INAN_ARGUMENT BARRIER VERB) (NOT 1* INAN_ARGUMENT BARRIER VERB) ;

SELECT:noun_animacy_rule_2 NI_NID IF ((-1* INAN_ARGUMENT BARRIER VERB) OR (1* INAN_ARGUMENT BARRIER VERB)) (NOT -1* AN_ARGUMENT BARRIER VERB) (NOT 1* AN_ARGUMENT BARRIER VERB) ;

### Argument Dependency - Rules to assign Verb - Noun/Pron dependency ###
### Current simplification: If noun can depend on more than 1 verb, set relation for the left-side verb

## LEFT SIDE DEPENDENCIES

## ANIMATE 3RD PERSON SUBJECT DEPENDENCY
SETRELATION:animate_subj_dep_1_L Dep_Subject TARGET (ProxSg) TO (-1* (3SgProxSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_2_L Dep_Subject TARGET (ProxPl) TO (-1* (3PlProxSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_3_L Dep_Subject TARGET (ObvSg) TO (-1* (3SgObvSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_4_L Dep_Subject TARGET (ObvPl) TO (-1* (3PlObvSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_5_L Dep_Subject TARGET (3Sg) TO (-1* (3SgProxSubj) OR (3SgObvSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_6_L Dep_Subject TARGET (3Pl) TO (-1* (3PlProxSubj) OR (3PlObvSubj) BARRIER VERB);


## ANIMATE NON-3RD PERSON SUBJECT DEPENDENCY
SETRELATION:animate_subj_dep_7_L Dep_Subject TARGET (1Sg) TO (-1* (1SgSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_8_L Dep_Subject TARGET (2Sg) TO (-1* (2SgSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_9_L Dep_Subject TARGET (2Pl) TO (-1* (2PlSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_10_L Dep_Subject TARGET (Excl) TO (-1* (ExclSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_11_L Dep_Subject TARGET (Incl) TO (-1* (InclSubj) BARRIER VERB);


## ANIMATE 3RD PERSON OBJECT DEPENDENCY
SETRELATION:animate_obj_dep_1_L Dep_Object TARGET (ProxSg) TO (-1* (3SgProxObj) BARRIER VERB);
SETRELATION:animate_obj_dep_2_L Dep_Object TARGET (ProxPl) TO (-1* (3PlProxObj) BARRIER VERB);
SETRELATION:animate_obj_dep_3_L Dep_Object TARGET (ObvSg) TO (-1* (3SgObvObj) BARRIER VERB) ;
SETRELATION:animate_obj_dep_4_L Dep_Object TARGET (ObvPl) TO (-1* (3PlObvObj) BARRIER VERB) ;
SETRELATION:animate_obj_dep_5_L Dep_Object TARGET (3Sg) TO (-1* (3SgProxObj) OR (VTA 3SgObvObj) BARRIER VERB);
SETRELATION:animate_obj_dep_6_L Dep_Object TARGET (3Pl) TO (-1* (3PlProxObj) OR (3PlObvObj) BARRIER VERB);


## ANIMATE NON-3RD PERSON OBJECT DEPENDENCY
SETRELATION:animate_obj_dep_7_L Dep_Object TARGET (1Sg) TO (-1* (1SgObj) BARRIER VERB);
SETRELATION:animate_obj_dep_8_L Dep_Object TARGET (2Sg) TO (-1* (2SgObj) BARRIER VERB);
SETRELATION:animate_obj_dep_9_L Dep_Object TARGET (2Pl) TO (-1* (2PlObj) BARRIER VERB);
SETRELATION:animate_obj_dep_10_L Dep_Object TARGET (Excl) TO (-1* (ExclObj) BARRIER VERB);
SETRELATION:animate_obj_dep_11_L Dep_Object TARGET (Incl) TO (-1* (InclObj) BARRIER VERB);


## INANIMATE SUBJECT DEPENDECY
SETRELATION:inanimate_subj_dep_1_L Dep_Subject TARGET (Sg) TO (-1* (0SgSubj) BARRIER VERB);
SETRELATION:inanimate_subj_dep_2_L Dep_Subject TARGET (Pl) TO (-1* (0PlSubj) BARRIER VERB);


## INANIMATE OBJECT DEPENDECY
SETRELATION:inanimate_subj_dep_1_L Dep_Object TARGET (Sg) TO (-1* (0SgObj) BARRIER VERB) ;
SETRELATION:inanimate_obj_dep_2_L Dep_Object TARGET (Pl) TO (-1* (0PlObj) BARRIER VERB) ;



## RIGHT SIDE DEPENDENCIES

## ANIMATE 3RD PERSON SUBJECT DEPENDENCY
SETRELATION:animate_subj_dep_1_R Dep_Subject TARGET (ProxSg) IF (NONE r:* (*)) TO (1* (3SgProxSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_2_R Dep_Subject TARGET (ProxPl) IF (NONE r:* (*)) TO (1* (3PlProxSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_3_R Dep_Subject TARGET (ObvSg) IF (NONE r:* (*)) TO (1* (3SgObvSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_4_R Dep_Subject TARGET (ObvPl) IF (NONE r:* (*)) TO (1* (3PlObvSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_5_R Dep_Subject TARGET (3Sg) IF (NONE r:* (*)) TO (1* (3SgProxSubj) OR (3SgObvSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_6_R Dep_Subject TARGET (3Pl) IF (NONE r:* (*)) TO (1* (3PlProxSubj) OR (3PlObvSubj) BARRIER VERB);


## ANIMATE NON-3RD PERSON SUBJECT DEPENDENCY
SETRELATION:animate_subj_dep_7_R Dep_Subject TARGET (1Sg) IF (NONE r:* (*)) TO (1* (1SgSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_8_R Dep_Subject TARGET (2Sg) IF (NONE r:* (*)) TO (1* (2SgSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_9_R Dep_Subject TARGET (2Pl) IF (NONE r:* (*)) TO (1* (2PlSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_10_R Dep_Subject TARGET (Excl) IF (NONE r:* (*)) TO (1* (ExclSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_11_R Dep_Subject TARGET (Incl) IF (NONE r:* (*)) TO (1* (InclSubj) BARRIER VERB);


## ANIMATE 3RD PERSON OBJECT DEPENDENCY
SETRELATION:animate_obj_dep_1_R Dep_Object TARGET (ProxSg) IF (NONE r:* (*)) TO (1* (3SgProxObj) BARRIER VERB);
SETRELATION:animate_obj_dep_2_R Dep_Object TARGET (ProxPl) IF (NONE r:* (*)) TO (1* (3PlProxObj) BARRIER VERB);
SETRELATION:animate_obj_dep_3_R Dep_Object TARGET (ObvSg) IF (NONE r:* (*)) TO (1* (3SgObvObj) BARRIER VERB) ;
SETRELATION:animate_obj_dep_4_R Dep_Object TARGET (ObvPl) IF (NONE r:* (*)) TO (1* (3PlObvObj) BARRIER VERB) ;
SETRELATION:animate_obj_dep_5_R Dep_Object TARGET (3Sg) IF (NONE r:* (*)) TO (1* (3SgProxObj) OR (VTA 3SgObvObj) BARRIER VERB);
SETRELATION:animate_obj_dep_6_R Dep_Object TARGET (3Pl) IF (NONE r:* (*)) TO (1* (3PlProxObj) OR (3PlObvObj) BARRIER VERB);


## ANIMATE NON-3RD PERSON OBJECT DEPENDENCY
SETRELATION:animate_obj_dep_7_R Dep_Object TARGET (1Sg) IF (NONE r:* (*)) TO (1* (1SgObj) BARRIER VERB);
SETRELATION:animate_obj_dep_8_R Dep_Object TARGET (2Sg) IF (NONE r:* (*)) TO (1* (2SgObj) BARRIER VERB);
SETRELATION:animate_obj_dep_9_R Dep_Object TARGET (2Pl) IF (NONE r:* (*)) TO (1* (2PlObj) BARRIER VERB);
SETRELATION:animate_obj_dep_10_R Dep_Object TARGET (Excl) IF (NONE r:* (*)) TO (1* (ExclObj) BARRIER VERB);
SETRELATION:animate_obj_dep_11_R Dep_Object TARGET (Incl) IF (NONE r:* (*)) TO (1* (InclObj) BARRIER VERB);


## INANIMATE SUBJECT DEPENDECY
SETRELATION:inanimate_subj_dep_1_R Dep_Subject TARGET (Sg) IF (NONE r:* (*)) TO (1* (0SgSubj) BARRIER VERB);
SETRELATION:inanimate_subj_dep_2_R Dep_Subject TARGET (Pl) IF (NONE r:* (*)) TO (1* (0PlSubj) BARRIER VERB);


## INANIMATE OBJECT DEPENDECY
SETRELATION:inanimate_subj_dep_1_R Dep_Object TARGET (Sg) IF (NONE r:* (*)) TO (1* (0SgObj) BARRIER VERB) ;
SETRELATION:inanimate_obj_dep_2_R Dep_Object TARGET (Pl) IF (NONE r:* (*)) TO (1* (0PlObj) BARRIER VERB) ;




### Dependency, Demonstrative Pronoun rules
###
# NOT SURE IF WORKS YET
# If there is a Noun immediately following a PRONDem, remove any added relation, and set relation to following Noun
###
REMRELATION:dem_pronoun_cleanup  Dep_Subject TARGET(PRONDem NA) IF (1 NA_NAD) TO ((-1* VERB) OR (1* VERB)) ;
REMRELATION:dem_pronoun_cleanup  Dep_Object TARGET(PRONDem NA) IF (1 NA_NAD) TO ((-1* VERB) OR (1* VERB)) ;

SETRELATION:dem_pronoun_dep_1 Dep_Demonstrative TARGET(PRONDem NA) TO (1 NA_NAD) ; 
SETRELATION:dem_pronoun_dep_2 Dep_Demonstrative TARGET(PRONDem NI) TO (1 NI_NID) ; 


### Oblique nominal argument rules
# NEED TO BE CHECKED
# If there is a loc noun before or after a verb, set argument relation
SETRELATION:obl_nominal_dep_L Dep_Obl TARGET NOMINAL + (Loc) TO (-1* VERB) ;
SETRELATION:obl_nominal_dep_R Dep_Obl TARGET NOMINAL + (Loc) IF (NONE r:* (*)) TO (1* VERB) ;


### Locative Adv rules
# NEED TO BE CHECKED
# IF there is no following loc noun, set obl relationship to verb (left-first)
SETRELATION:loc_adv_dep_L Dep_Obl TARGET (ADVLoc) TO (-1* VERB) ;
SETRELATION:loc_adv_dep_R Dep_Obl TARGET (ADVLoc) IF (NONE r:* (*)) TO (1* VERB) ;

# If there is a loc noun following a loc adv, set dependency to noun
REMRELATION:loc_adv_cleanup_1  Dep_Obl TARGET (ADVLoc) IF (1 NOMINAL + (Loc)) TO ((-1* VERB) OR (1* VERB)) ;
SETRELATION:loc_adv_dep_1 Dep_Prep TARGET (ADVLoc) TO (1 NOMINAL + (Loc)) ;

# If there is a loc adv following a loc adv belonging to special set, set prep dependency
REMRELATION:special_loc_cleanup_1  Dep_Obl TARGET SPECIAL_LOCS IF (1 (ADVLoc)) TO ((-1* VERB) OR (1* VERB)) ;
SETRELATION:special_loc_dep_1 Dep_Prep TARGET SPECIAL_LOCS TO (1 (ADVLoc)) ;

# If loc adv belongs to special set, set dependency to following verb if present
REMRELATION:special_loc_cleanup_2 Dep_Obl TARGET SPECIAL_LOCS IF (1 VERB) TO ((-1* VERB) OR (1* VERB)) ;
SETRELATION:special_loc_dep_2 Dep_Obl TARGET SPECIAL_LOCS TO (1 VERB) ;



### Temporal Adv rules
# SIMPLE VERSION - NEED TO BE CHECKED
# Set advmod relationship to verb (left-first)
SETRELATION:tmp_adv_dep_L Dep_AdvMod TARGET (ADVTmp) TO (-1* VERB) ;
SETRELATION:tmp_adv_dep_R Dep_AdvMod TARGET (ADVTmp) IF (NONE r:* (*)) TO (1* VERB) ;



### Manner Adv rules
# SIMPLE VERSION - NEED TO BE CHECKED
# Set advmod relationship to verb (left-first)
SETRELATION:man_adv_dep_L Dep_AdvMod TARGET (ADVMan) TO (-1* VERB) ;
SETRELATION:man_adv_dep_R Dep_AdvMod TARGET (ADVMan) IF (NONE r:* (*)) TO (1* VERB) ;


### Degree Adv rules
# SIMPLE VERSION - NEED TO BE CHECKED
# Set advmod relationship to verb (left-first)
SETRELATION:deg_adv_dep_L Dep_AdvMod TARGET (AVDDeg) TO (-1 ADV) ;
SETRELATION:deg_adv_dep_R Dep_AdvMod TARGET (AVDDeg) IF (NONE r:* (*)) TO (1 ADV) ;

### Negative Adv rules 
# Gaawiin - s relationship to closest neg verb (right-only)
SETRELATION:neg_adv_dep_gwn Dep_Neg TARGET ("gaawiin") TO (1* (Neg)) ;

SETRELATION:neg_adv_dep_gg Dep_Neg TARGET ("gego") TO (1* (Prb)) ;


### Relative clause rule (experimental)
SETRELATION:relcl_dep_1 Dep_RelCl TARGET (Cnj 3SgProxSubj) TO (-1 (3SgProxPoss));





### Help with post-processing (Adding tags for CoNLL-U conversion)
ADD:Is_Noun (NOUN) TARGET NOMINAL IF (NOT 0 PRON) (NOT 0 (NOUN)) ;
ADD:Is_Det (DET) TARGET (PRONDem) IF (1 (NOUN)) (NOT 0 (DET)) ;
ADD:Is_Pron (PRON) TARGET PRON IF (NOT 0 (DET)) (NOT 0 (PRON)) ;
ADD:Is_Verb (VERB) TARGET VERB (NOT 0 (VERB)) ;
ADD:Is_Adv (ADV) TARGET ADV (NOT 0 (ADV)) ;
ADD:Is_Part (PART) TARGET PART (NOT 0 (PART));
ADD:Is_Intj (INTJ) TARGET (PCInterj) (NOT 0 (INTJ));