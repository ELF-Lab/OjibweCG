="."><fst_output lemma="." analysis="" /></token></sentence></text_ojb></paragraph><paragraph num="3" page_ojb="60" page_eng="61"><text_eng> While they were going around berry picking, she realized  her little sister was missing. She searched all over and called out  for her to no avail. And then she became so frightened that she  changed her condition and became a bird.  </text_eng><text_ojb><sentence num="1"><sent_text>Megwaa igo babaa-mawinzowaad, gaa-izhi-metasinaad iniw oshiimeyan.</sent_text><token word="megwaa"><fst_output lemma="megwaa" analysis="megwaa+ADVTmp" /></token><token word="igo"><fst_output lemma="igo" analysis="PCEmph" /></token><token word="babaa-mawinzowaad"><fst_output lemma="mawinzo" analysis="PVDir/babaa+mawinzo+VAI+Cnj+Pos+Neu+3PlProxSubj" /></token><token word=","><fst_output lemma="PUNCT" analysis="" /></token><token word="gaa-izhi-metasinaad"><fst_output lemma="metasin" analysis="ChCnj+PVTense/gii+PVRel/izhi+metasin+VTA+Cnj+Pos+Neu+3SgProxSubj+3PlObvObj" /><fst_output lemma="metasin" analysis="ChCnj+PVTense/gii+PVRel/izhi+metasin+VTA+Cnj+Pos+Neu+3SgProxSubj+3SgObvObj" /></token><token word="iniw"><fst_output lemma="iniw" analysis="PRONDem+iniw+NA+ObvSg" /><fst_output lemma="iniw" analysis="PRONDem+iniw+NA+ObvPl" /></token><token word="oshiimeyan"><fst_output lemma="shiimey" analysis="shiimey+NAD+ObvSg+3SgProxPoss" /><fst_output lemma="shiimey" analysis="shiimey+NAD+ObvPl+3SgProxPoss" /></token><token word="."><fst_output lemma="." analysis="" /></token></sentence><sentence num="2"><sent_text>Miziwe ogii-nandawaabamaan miinawaa aano-biibaagiimaad.</sent_text><token word="miziwe"><fst_output lemma="miziwe" analysis="miziwe+ADVLoc" /></token><token word="ogii-nandawaabamaan"><fst_output lemma="andawaabam" analysis="PVTense/gii+andawaabam+VTA+Ind+Pos+Neu+3SgProxSubj+3PlObvObj" /><fst_output lemma="andawaabam" analysis="PVTense/gii+andawaabam+VTA+Ind+Pos+Neu+3SgProxSubj+3SgObvObj" /></token><token word="miinawaa"><fst_output lemma="miinawaa" a