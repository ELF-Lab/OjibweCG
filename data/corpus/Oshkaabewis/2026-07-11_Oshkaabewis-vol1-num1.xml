njii" analysis="ChCnj+onjii+VAI+Cnj+Pos+Neu+3PlProxSubj" /></token></sentence><sentence num="2"><sent_text>Mii sa wedi wiishkonsing keyaa gaa-pi-onjiiwaad.</sent_text><token word="mii"><fst_output lemma="mii" analysis="mii+ADVPred" /></token><token word="sa"><fst_output lemma="sa" analysis="PCDisc" /></token><token word="wedi"><fst_output lemma="wedi" analysis="wedi+?" /></token><token word="wiishkonsing"><fst_output lemma="wiishkonsing" analysis="wiishkonsing+?" /></token><token word="keyaa"><fst_output lemma="keyaa" analysis="keyaa+ADVLoc" /></token><token word="gaa-pi-onjiiwaad"><fst_output lemma="onjii" analysis="ChCnj+PVTense/gii+PVDir/bi+onjii+VAI+Cnj+Pos+Neu+3PlProxSubj" /></token></sentence><sentence num="3"><sent_text>Mii sa wedi miishigamiing gaa-tazhi-nitaawigiyaan niin, omaapii dash sa noongom minisootaang ingii-pi-daniz.</sent_text><token word="mii"><fst_output lemma="mii" analysis="mii+ADVPred" /></token><token word="sa"><fst_output lemma="sa" analysis="PCDisc" /></token><token word="wedi"><fst_output lemma="wedi" analysis="wedi+?" /></token><token word="miishigamiing"><fst_output lemma="miishigamiing" analysis="miishigamiing+?" /></token><token word="gaa-tazhi-nitaawigiyaan"><fst_output lemma="nitaawigi" analysis="ChCnj+PVTense/gii+PVRel/dazhi+nitaawigi+VAI+Cnj+Pos+Neu+1SgSubj" /></token><token word="niin"><fst_output lemma="niin" analysis="PRONPer+niin+NA+1Sg" /></token><token word="omaapii"><fst_output lemma="omaapii" analysis="omaapii+?" /></token><token word="dash"><fst_output lemma="dash" analysis="dash+ADVConj" /></token><token word="sa"><fst_output lemma="sa" analysis="PCDisc" /></token><token word="noongom"><fst_output lemma="noongom" analysis="noongom+ADVTmp" /></token><token word="minisootaang"><fst_output lemma="minisootaang" analysis="minisootaang+?" /></token><token word="ingii-pi-daniz"><fst_output lemma="danizo" analysis="PVTense/gii+PVDir/bi+danizo+VAI+Ind+Pos+Neu+1SgSubj" /><fst_output lemma="danizi" analysis="PVTense/gii+PVDir/bi+danizi+VAI+Ind+Pos+Neu+1SgSubj" /></token></sentence><sentence num="4"><sent_text>Ingoding dash igo naana'idaa bezhig gekaad indi-nawemaagan gii-pi-odishiwe, 'bwaaziwanishinaabewid', mii gaa-izhi-inenimag a'aw akiwenziiyiban.</sent_text><token word="ingoding"><fst_output lemma="ingoding" analysis="ingoding+ADVTmp" /></token><token word="dash"><fst_output lemma="dash" analysis="dash+ADVConj" /></token><token word="igo"><fst_output lemma="igo" analysis="PCEmph" /></token><token word="naana'idaa"><fst_output lemma="naana'idaa" analysis="naana'idaa+ADVTmp" /></token><token word="bezhig"><fst_output lemma="bezhig" analysis="bezhig+NUM" /></token><token word="gekaad"><fst_output lemma="gikaa" analysis="ChCnj+gikaa+VAI+Cnj+Pos+Neu+3SgProxSubj" /><fst_output lemma="gikaa" analysis="gikaa+VAI+Pcp/ChCnj+Pos+Neu+3SgProxSubj+3SgProxHead" /></token><token word="indi-nawemaagan"><fst_output lemma="indi-nawemaagan" analysis="indi-nawemaagan+?" /></token><token word="gii-pi-odishiwe"><fst_output lemma="odishiwe" analysis="PVTense/gii+PVDir/bi+odishiwe+VAI+Ind+Pos+Neu+3SgProxSubj" /></token><token word="'bwaaziwanishinaabewid'"><fst_output lemma="'bwaaziwanishinaabewid'" analysis="'bwaaziwanishinaabewid'+?" /></token><token word="mii"><fst_output lemma="mii" analysis="mii+ADVPred" /></token><token word="gaa-izhi-inenimag"><fst_output lemma="inenim" analysis="ChCnj+PVTense/gii+PVRel/izhi+inenim+VTA+Cnj+Pos+Neu+1SgSubj+3SgProxObj" /></token><token word="a'aw"><fst_output lemma="a'aw" analysis="PRONDem+a'aw+NA+ProxSg" /></token><token word="akiwenziiyiban"><fst_output lemma="akiwenzii" analysis="akiwenzii+NA+Pret+ProxSg" /></token></sentence><sentence num="5"><sent_text>Aapiji sa go wawiinge gii-anishinaabewaadizi a'aw.</sent_text><token word="aapiji"><fst_output lemma="aapiji" analysis="aapiji+ADVDeg" /></token><token word="sa"><fst_output lemma="sa" analysis="PCDisc" /></token><token word="go"><fst_output lemma="go" analysis="PCDisc" /></token><token word="wawiinge"><fst_output lemma="w