# ADD:noun_subj_vta_rule_3 @SUBJ TARGET NA_NAD + (ObvSg) IF ((-1* (VTA 3SgObvSubj)) OR (1* (VTA 3SgObvSubj))) ;

# ADD:noun_subj_vta_rule_4 @SUBJ TARGET NA_NAD + (ObvPl) IF ((-1* (VTA 3PlObvSubj) ) OR (1* (VTA 3PlObvSubj))) ;

# ADD:noun_obj_vta_rule_5 @OBJ TARGET NA_NAD + (ObvSg) IF ((-1* (VTA 3SgObvObj)) OR (1* (VTA 3SgObvObj))) ;

# ADD:noun_obj_vta_rule_6 @OBJ TARGET NA_NAD + (ObvPl) IF ((-1* (VTA 3PlObvObj)) OR (1* (VTA 3PlObvObj))) ;

# ADD:noun_obj_vta_rule_7 @OBJ TARGET NA_NAD + (ProxSg) IF ((-1* (VTA 3SgProxObj)) OR (1* (VTA 3SgProxObj)));

# ADD:noun_obj_vta_rule_8 @OBJ TARGET NA_NAD + (ProxPl) IF ((-1* (VTA 3PlProxObj)) OR (1* (VTA 3PlProxObj)));

## Nouns related to VAI
# ADD:noun_subj_vai_rule_1 @SUBJ TARGET NA_NAD + (ObvPl) IF ((-1* (VAI 3PlObvSubj)) OR (1* (VAI 3PlObvSubj)));

# ADD:noun_subj_vai_rule_2 @SUBJ TARGET NA_NAD + (ObvSg) IF ((-1* (VAI 3SgObvSubj)) OR (1* (VAI 3SgObvSubj)));

# ADD:noun_subj_vai_rule_3 @SUBJ TARGET NA_NAD + (ProxPl) IF ((-1* (VAI 3PlProxSubj)) OR (1* (VAI 3PlProxSubj)));

# ADD:noun_subj_vai_rule_4 @SUBJ TARGET NA_NAD + (ProxSg) IF ((-1* (VAI 3SgObvSubj)) OR (1* (VAI 3SgProxSubj)));


### Dependency Nouns - Rules to assign Verb - Noun dependency (parent - child) ###
## VTA - NOUN dependency
ADDRELATION:vta_dep_rule_1_L Dep_Subject TARGET NA_NAD + (ProxSg) TO (-1* (VTA 3SgProxSubj) BARRIER VERB) ;
ADDRELATION:vta_dep_rule_1_R Dep_Subject TARGET NA_NAD + (ProxSg) TO (1* (VTA 3SgProxSubj) BARRIER VERB) ;


ADDRELATION:vta_dep_rule_2_L Dep_Subject TARGET NA_NAD + (ProxPl) TO (-1* (VTA 3PlProxSubj) BARRIER VERB) ;
ADDRELATION:vta_dep_rule_2_R Dep_Subject TARGET NA_NAD + (ProxPl) TO (1* (VTA 3PlProxSubj) BARRIER VERB) ;


ADDRELATION:vta_dep_rule_3_L Dep_Subject TARGET NA_NAD + (ObvSg) TO (-1* (VTA 3SgObvSubj) BARRIER VERB) ;
ADDRELATION:vta_dep_rule_3_R Dep_Subject TARGET NA_NAD + (ObvSg) TO (1* (VTA 3SgObvSubj) BARRIER VERB) ;


ADDRELATION:vta_dep_rule_4_L Dep_Subject TARGET NA_NAD + (ObvPl) TO (-1* (VTA 3PlObvSubj) BARRIER VERB) ;
ADDRELATION:vta_dep_rule_4_R Dep_Subject TARGET NA_NAD + (ObvPl) TO (1* (VTA 3PlObvSubj) BARRIER VERB) ;


ADDRELATION:vta_dep_rule_5_L Dep_Object TARGET NA_NAD + (ObvSg) TO (-1* (VTA 3SgObvObj) BARRIER VERB) ;
ADDRELATION:vta_dep_rule_5_R Dep_Object TARGET NA_NAD + (ObvSg) TO (1* (VTA 3SgObvObj) BARRIER VERB) ;


ADDRELATION:vta_dep_rule_6_L Dep_Object TARGET NA_NAD + (ObvPl) TO (-1* (VTA 3PlObvObj) BARRIER VERB) ;
ADDRELATION:vta_dep_rule_6_R Dep_Object TARGET NA_NAD + (ObvPl) TO (1* (VTA 3PlObvObj) BARRIER VERB) ;


ADDRELATION:vta_dep_rule_7_L Dep_Object TARGET NA_NAD + (ProxSg) TO (-1* (VTA 3SgProxObj) BARRIER VERB);
ADDRELATION:vta_dep_rule_7_R Dep_Object TARGET NA_NAD + (ProxSg) TO (1* (VTA 3SgProxObj) BARRIER VERB);

ADDRELATION:vta_dep_rule_8_L Dep_Object TARGET NA_NAD + (ProxPl) TO (-1* (VTA 3PlProxObj) BARRIER VERB);
ADDRELATION:vta_dep_rule_8_R Dep_Object TARGET NA_NAD + (ProxPl) TO (1* (VTA 3PlProxObj) BARRIER VERB);

## VAI - NOUN dependency
ADDRELATION:vai_dep_rule_1_L Dep_Subject TARGET NA_NAD + (ObvPl) TO (-1* (VAI 3PlObvSubj) BARRIER VERB);
ADDRELATION:vai_dep_rule_1_R Dep_Subject TARGET NA_NAD + (ObvPl) TO (1* (VAI 3PlObvSubj) BARRIER VERB);

ADDRELATION:vai_dep_rule_2_L Dep_Subject TARGET NA_NAD + (ObvSg) TO (-1* (VAI 3SgObvSubj) BARRIER VERB);
ADDRELATION:vai_dep_rule_2_R Dep_Subject TARGET NA_NAD + (ObvSg) TO (1* (VAI 3SgObvSubj) BARRIER VERB);

ADDRELATION:vai_dep_rule_3_L Dep_Subject TARGET NA_NAD + (ProxPl) TO (-1* (VAI 3PlProxSubj) BARRIER VERB);
ADDRELATION:vai_dep_rule_3_R Dep_Subject TARGET NA_NAD + (ProxPl) TO (1* (VAI 3PlProxSubj) BARRIER VERB);

ADDRELATION:vai_dep_rule_4_L Dep_Subject TARGET NA_NAD + (ProxSg) TO (-1* (VAI 3SgProxSubj) BARRIER VERB);
ADDRELATION:vai_dep_rule_4_R Dep_Subject TARGET NA_NAD + (ProxSg) TO (1* (VAI 3SgProxSubj) BARRIER VERB);


## VTI - NOUN dependency
ADDRELATION:vti_dep_rule_1_L Dep_Subject TARGET NA_NAD + (ProxSg) TO (-1* (VTI 3SgProxSubj) BARRIER VERB) ;
ADDRELATION:vti_dep_rule_1_R Dep_Subject TARGET NA_NAD + (ProxSg) TO (1* (VTI 3SgProxSubj) BARRIER VERB) ;

ADDRELATION:vti_dep_rule_2_L Dep_Subject TARGET NA_NAD + (ProxPl) TO (-1* (VTI 3PlProxSubj) BARRIER VERB) ;
ADDRELATION:vti_dep_rule_2_R Dep_Subject TARGET NA_NAD + (ProxPl) TO (1* (VTI 3PlProxSubj) BARRIER VERB) ;

ADDRELATION:vti_dep_rule_3_L Dep_Subject TARGET NA_NAD + (ObvSg) TO (-1* (VTI 3SgObvSubj) BARRIER VERB) ;
ADDRELATION:vti_dep_rule_3_R Dep_Subject TARGET NA_NAD + (ObvSg) TO (1* (VTI 3SgObvSubj) BARRIER VERB) ;

ADDRELATION:vti_dep_rule_4_L Dep_Subject TARGET NA_NAD + (ObvPl) TO (-1* (VTI 3PlObvSubj) BARRIER VERB) ;
ADDRELATION:vti_dep_rule_4_R Dep_Subject TARGET NA_NAD + (ObvPl) TO (1* (VTI 3PlObvSubj) BARRIER VERB) ;

ADDRELATION:vti_dep_rule_5_L Dep_Object TARGET NI_NID + (Sg) TO (-1* (VTI 0SgObj) BARRIER VERB) ;
ADDRELATION:vti_dep_rule_5_R Dep_Object TARGET NI_NID + (Sg) TO (1* (VTI 0SgObj) BARRIER VERB) ;

ADDRELATION:vti_dep_rule_6_L Dep_Object TARGET NI_NID + (Pl) TO (-1* (VTI 0PlObj) BARRIER VERB) ;
ADDRELATION:vti_dep_rule_6_R Dep_Object TARGET NI_NID + (Pl) TO (1* (VTI 0PlObj) BARRIER VERB) ;


## VII - NOUN dependency
ADDRELATION:vai_dep_rule_1_L Dep_Subject TARGET NA_NAD + (Sg) TO (-1* (VII 0SgSubj) BARRIER VERB);
ADDRELATION:vai_dep_rule_1_R Dep_Subject TARGET NA_NAD + (Sg) TO (1* (VII 0SgSubj) BARRIER VERB);

ADDRELATION:vai_dep_rule_2_L Dep_Subject TARGET NA_NAD + (Pl) TO (-1* (VII 0PlSubj) BARRIER VERB);
ADDRELATION:vai_dep_rule_2_R Dep_Subject TARGET NA_NAD + (Pl) TO (1* (VII 0PlSubj) BARRIER VERB);

## VAIO - NOUN dependency
ADDRELATION:vaio_dep_rule_1_L Dep_Subject TARGET NA_NAD + (ObvPl) TO (-1* (VAIO 3PlObvSubj) BARRIER VERB);
ADDRELATION:vaio_dep_rule_1_R Dep_Subject TARGET NA_NAD + (ObvPl) TO (1* (VAIO 3PlObvSubj) BARRIER VERB);

ADDRELATION:vaio_dep_rule_2_L Dep_Subject TARGET NA_NAD + (ObvSg) TO (-1* (VAIO 3SgObvSubj) BARRIER VERB);
ADDRELATION:vaio_dep_rule_2_R Dep_Subject TARGET NA_NAD + (ObvSg) TO (1* (VAIO 3SgObvSubj) BARRIER VERB);

ADDRELATION:vaio_dep_rule_3_L Dep_Subject TARGET NA_NAD + (ProxPl) TO (-1* (VAIO 3PlProxSubj) BARRIER VERB);
ADDRELATION:vaio_dep_rule_3_R Dep_Subject TARGET NA_NAD + (ProxPl) TO (1* (VAIO 3PlProxSubj) BARRIER VERB);

ADDRELATION:vaio_dep_rule_4_L Dep_Subject TARGET NA_NAD + (ProxSg) TO (-1* (VAIO 3SgProxSubj) BARRIER VERB);
ADDRELATION:vaio_dep_rule_4_R Dep_Subject TARGET NA_NAD + (ProxSg) TO (1* (VAIO 3SgProxSubj) BARRIER VERB);

ADDRELATION:vaio_dep_rule_5_L Dep_Object TARGET NI_NID + (Sg) TO (-1* (VAIO 0SgObj) BARRIER VERB) ;
ADDRELATION:vaio_dep_rule_5_R Dep_Object TARGET NI_NID + (Sg) TO (1* (VAIO 0SgObj) BARRIER VERB) ;

ADDRELATION:vaio_dep_rule_6_L Dep_Object TARGET NI_NID + (Pl)  TO (-1* (VAIO 0PlObj) BARRIER VERB) ;
ADDRELATION:vaio_dep_rule_6_R Dep_Object TARGET NI_NID + (Pl)  TO (1* (VAIO 0PlObj) BARRIER VERB) ;



### Dependency, Demonstrative Pronoun rules
### Simple assumption: the Demonstrative depends on the next Noun if it exists
SETRELATION:dem_pronoun_dep_rule_1 Dep_Demonstrative TARGET(PRONDem NA) TO (1 NA_NAD) ; 
SETRELATION:dem_pronoun_dep_rule_2 Dep_Demonstrative TARGET(PRONDem NI) TO (1 NI_NID) ; 

