# This is an Constraint Grammar rules file for Ojibwe language.

# There is no built-in manual yet. Resources:
# http://visl.sdu.dk/cg3.html
# http://groups.google.com/group/constraint-grammar
# http://kevindonnelly.org.uk/2010/05/constraint-grammar-tutorial/

# Firstly, we need to define what tags should be considered sentence delimiters. For this example, only full stop is set as delimiter.


DELIMITERS = "<.>" ;

# We can define sets for common tag clusters
LIST VTA = VTA ;
LIST 3SgObvObj = 3SgObvObj ; # 3rd Singular Obviative Object
LIST 3PlObvObj = 3PlObvObj ; # 3rd Plural Obviative Object
LIST 3SgProxSubj = 3SgProxSubj ; # 3rd Singular Proximate Subject
LIST 3PlProxSubj = 3PlProxSubj ; # 3rd Plural Proximate Subject
LIST NA = NA ;
LIST ProxSg = ProxSg ;
LIST ProxPl = ProxPl ;
LIST ObvSg = ObvSg ;
LIST ObvPl = ObvPl ;

SECTION
# If there is a Singular Proximate Noun to the left of verb, 
# the verb should has Singular Prox Subject tag
SELECT:vta_rule_1 (VTA 3SgProxSubj) IF ((-1* (NA ProxSg)) OR (1* (NA ProxSg))) ;

# If there is a Plural Proximate Noun to the left of verb, 
# the verb should has Plural Prox Subject tag
SELECT:vta_rule_2 (VTA 3PlProxSubj) IF ((-1* (NA ProxPl)) OR (1* (NA ProxPl))) ;

SELECT:vta_rule_3 (VTA 3SgObvSubj) IF ((-1* (NA ObvSg)) OR (1* (NA ObvSg))) ;

SELECT:vta_rule_4 (VTA 3PlObvSubj) IF ((-1* (NA ObvPl)) OR (1* (NA ObvPl))) ;

# If there is a Singular Obviative Noun to the left of verb, 
# the verb should has Singular Obv Object tag
SELECT:vta_rule_5 (VTA 3SgObvObj) IF ((-1* (NA ObvSg)) OR (1* (NA ObvSg))) ;

# If there is a Singular Obviative Noun to the left of verb, 
# the verb should has Singular Obviative Object tag
SELECT:vta_rule_6 (VTA 3PlObvObj) IF ((-1* (NA ObvPl)) OR (1* (NA ObvPl))) ;

# Select 3SgProx Object if there's a Animate Proximate Singular around
SELECT:vta_rule_7 (VTA 3SgProxObj) IF ((-1* (NA ProxSg)) OR (1* (NA ProxSg)));

SELECT:vta_rule_8 (VTA 3PlProxObj) IF ((-1* (NA ProxPl)) OR (1* (NA ProxPl)));

# VTI verbs
SELECT:vti_rule_1 (VTI 0PlObj) IF ((-1* (NI Pl)) OR (1* (NI Pl)));

SELECT:vti_rule_2 (VTI 0SgObj) IF ((-1* (NI Sg)) OR (1* (NI Sg)));

# this rule is uncertain to solve?
SELECT:vti_rule_3 (VTI 3PlObvSubj) IF ((-1* (NID Pl)) OR (1* (NID Pl)));

SELECT:vti_rule_4 (VTI 3SgObvSubj) IF ((-1* (NID Sg)) OR (1* (NID Sg)));

# VAI rules
SELECT:vai_rule_1 (VAI 3PlObvSubj) IF ((-1* (NA ObvPl)) OR (1* (NA ObvPl)));

SELECT:vai_rule_2 (VAI 3SgObvSubj) IF ((-1* (NA ObvSg)) OR (1* (NA ObvSg)));

# VAIO rules
# placeholder

# VII rules
SELECT:vii_rule_1 (VII 0PlSubj) IF ((-1* (NI Pl)) OR (1* (NI Pl)));

SELECT:vii_rule_2 (VII 0SgSubj) IF ((-1* (NI Sg)) OR (1* (NI Sg)));
