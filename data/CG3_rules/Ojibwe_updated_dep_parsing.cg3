# This is the dependency parsing file for Anishinaabemowin (Ojibwe).

# Define to set as sentence delimeters
DELIMITERS = "<.>" "<?>" "<!>" "<¶>";

# We can define sets for common tag clusters
LIST VTA = VTA ;
LIST 3SgObvObj = 3SgObvObj ; # 3rd Singular Obviative Object
LIST 3PlObvObj = 3PlObvObj ; # 3rd Plural Obviative Object
LIST 3SgProxSubj = 3SgProxSubj ; # 3rd Singular Proximate Subject
LIST 3PlProxSubj = 3PlProxSubj ; # 3rd Plural Proximate Subject
LIST NA = NA ;
LIST ProxSg = ProxSg ;
LIST ProxPl = ProxPl ;
LIST ObvSg = ObvSg ;
LIST ObvPl = ObvPl ;

# LIST RELATION_VERB_NOUN = Dep_V_N ; 
LIST Dep_Subject = Dep_Subj_V ;
LIST Dep_Object = Dep_Obj_V ; 
LIST Dep_Adv = Dep_Adv_V ;
LIST Dep_Obl = Dep_Obl_V ;
LIST Dep_AdvMod = Dep_AdvMod_V ;
LIST Dep_Neg = Dep_Neg_V ;

LIST Dep_Demonstrative = Dep_Dem_N ; 
LIST Dep_Prep = Dep_Prep_N ;
LIST Dep_RelCl = Dep_RelCl_N;
LIST Dep_NumMod = Dep_NumMod_N;

LIST PREVERB = PVSub/gaa PVTense/gii;

# Groups of tags to refer to
LIST SG_AN_SUBJECT = 3SgProxSubj 3SgObvSubj ;
LIST PL_AN_SUBJECT = 3PlProxSubj 3PlObvSubj ;
SET AN_SUBJECT = SG_AN_SUBJECT OR  PL_AN_SUBJECT ;

LIST SG_AN_OBJECT = 3SgProxObj 3SgObvObj ;
LIST PL_AN_OBJECT = 3PlProxObj 3PlObvObj ;
SET AN_OBJECT = SG_AN_OBJECT OR PL_AN_OBJECT ;

SET AN_ARGUMENT = AN_SUBJECT OR AN_OBJECT ;


LIST SG_INAN_SUBJECT = 0SgSubj 0SgObvSubj ;
LIST PL_INAN_SUBJECT = 0PlSubj 0PlObvSubj ;
SET INAN_SUBJECT = SG_INAN_SUBJECT OR  PL_INAN_SUBJECT ;

LIST SG_INAN_OBJECT = 0SgObj 0SgObvObj ;
LIST PL_INAN_OBJECT = 0PlObj 0PlObvObj ;
SET INAN_OBJECT = SG_INAN_OBJECT OR PL_INAN_OBJECT ;

SET INAN_ARGUMENT = INAN_SUBJECT OR INAN_OBJECT ;


SET NA_NAD = (NA) OR (NAD) ;
SET NI_NID = (NI) OR (NID) ;

# Pronouns that are ambiguous for number/obviation
SET AN_SPECIAL_PRON = (PRONIndf NA) OR (PRONInter NA) OR (PRONPret NA);
SET INAN_SPECIAL_PRON = (PRONIndf NI);

# TODO: rename
SET SPECIAL_LOCS = ("o'omaa") OR ("omaa") OR ("i'imaa") OR ("imaa") OR ("i'iwidi") OR ("iwidi") OR ("o'owidi") OR ("owidi") ;
SET SPECIAL_ADVS = ("debinaak") OR ("nising") OR ("niiwing") OR ("niizhing") OR ("dasing") ;

SET NOMINAL = NA_NAD OR NI_NID ;
SET VERB = (VTA) OR (VAI) OR (VTI) OR (VII) OR (VAIO) ;
SET ADV = (ADVConj)  OR (ADVDisc) OR (ADVDub) OR (ADVGram) OR (ADVInter) OR (ADVLoc) OR (ADVMan) OR (ADVNeg) OR (ADVPred) OR (ADVQnt) OR (ADVTmp) OR (AVDDeg);
SET PRON = (PRONDem) OR (PRONDub) OR (PRONIndf) OR (PRONInter) OR (PRONPret) OR (PRONSim) OR (PRONPer) ;
SET PART = (PCEmph) OR (PCDisc) OR (PCAsp) ;


SECTION

### Blanket constraints (context independent)

## Select Loc Adv readings UNCONDITIONALLY if available
# TODO: not fully checked, eye test for ~30 examples seems to work
SELECT:select_adv_loc TARGET (ADVLoc) ;
## Select adverbs from the special set
SELECT:select_special_adv TARGET SPECIAL_ADVS ;


## DEV NOTE May 27: DELETED ALL OBV SG VS PL RULES - MAKE SURE CORRECT

### VERBS - Rules to handle ambiguity of verbs ###

## ANIMATE SUBJECT (VTA, VTI, VAI, VAIO)
## (Obviative forms not disambiguated - inherently ambiguous)

SELECT:animate_subj_rule_1 (3SgProxSubj) IF ((-1* NA_NAD + (ProxSg) BARRIER NOMINAL) OR (1* NA_NAD + (ProxSg) BARRIER NOMINAL)) ;

SELECT:animate_subj_rule_2 (3PlProxSubj) IF ((-1* NA_NAD + (ProxPl) BARRIER NOMINAL) OR (1* NA_NAD + (ProxPl) BARRIER NOMINAL)) ;


## ANIMATE OBJECT (VTA)
## (Obviative forms not disambiguated - inherently ambiguous)

SELECT:animate_obj_rule_1 (3SgProxObj) IF ((-1* NA_NAD + (ProxSg) BARRIER NOMINAL) OR (1* NA_NAD + (ProxSg) BARRIER NOMINAL));

SELECT:animate_obj_rule_2 (3PlProxObj) IF ((-1* NA_NAD + (ProxPl) BARRIER NOMINAL) OR (1* NA_NAD + (ProxPl) BARRIER NOMINAL));

## INANIMATE SUBJECT (VII)

SELECT:inanimate_subj_rule_1 SG_INAN_SUBJECT IF ((-1* NI_NID + (Sg) BARRIER NOMINAL) OR (1* NI_NID + (Sg) BARRIER NOMINAL));

SELECT:inanimate_subj_rule_2 PL_INAN_SUBJECT IF ((-1* NI_NID + (Pl) BARRIER NOMINAL) OR (1* NI_NID + (Pl) BARRIER NOMINAL));


## INANIMATE OBJECT (VTI, VAIO)

SELECT:inanimate_obj_rule_1 SG_INAN_OBJECT IF ((-1* NI_NID + (Sg) BARRIER NOMINAL) OR (1* NI_NID + (Sg) BARRIER NOMINAL));

SELECT:inanimate_obj_rule_2 PL_INAN_OBJECT IF ((-1* NI_NID + (Pl) BARRIER NOMINAL) OR (1* NI_NID + (Pl) BARRIER NOMINAL));



## TODO: where to put this??
# Remove VAIO tag if no NI/NID noun nearby
REMOVE:vaio_rule_1 (VAIO) IF (NOT (-1* NI_NID BARRIER NOMINAL) OR (1* NI_NID BARRIER NOMINAL)) ;

## ANIMACY DISAMBIGUATION

# Should solve VTA/VTI
SELECT:verb_animacy_rule_1 AN_OBJECT IF ((-1* NA_NAD BARRIER NOMINAL) OR (1* NA_NAD BARRIER NOMINAL)) (NOT -1* NI_NID BARRIER NOMINAL) (NOT 1* NI_NID BARRIER NOMINAL) ;

SELECT:verb_animacy_rule_2 INAN_OBJECT IF ((-1* NI_NID BARRIER NOMINAL) OR (1* NI_NID BARRIER NOMINAL)) (NOT -1* NA_NAD BARRIER NOMINAL) (NOT 1* NA_NAD BARRIER NOMINAL) ;

# Should solve VAI/VII
SELECT:verb_animacy_rule_1 AN_SUBJECT IF ((-1* NA_NAD BARRIER NOMINAL) OR (1* NA_NAD BARRIER NOMINAL)) (NOT -1* NI_NID BARRIER NOMINAL) (NOT 1* NI_NID BARRIER NOMINAL) ;

SELECT:verb_animacy_rule_2 INAN_SUBJECT IF ((-1* NI_NID BARRIER NOMINAL) OR (1* NI_NID BARRIER NOMINAL)) (NOT -1* NA_NAD BARRIER NOMINAL) (NOT 1* NA_NAD BARRIER NOMINAL) ;


### NOUNS - Rules to handle ambiguity of nouns ###

## NUMBER DISAMBIGUATION

## ANIMATE NOUNS

SELECT:noun_number_rule_1 NA_NAD + (ProxSg) IF ((-1* (3SgProxSubj) OR (3SgProxObj) BARRIER VERB) OR (1* (3SgProxSubj) OR (3SgProxObj) BARRIER VERB)) ;

SELECT:noun_number_rule_2 NA_NAD + (ProxPl) IF ((-1* (3PlProxSubj) OR (3PlProxObj) BARRIER VERB) OR (1* (3PlProxSubj) OR (3PlProxObj) BARRIER VERB)) ;


## INANIMATE NOUNS

SELECT:noun_number_rule_3 NI_NID + (Sg) IF ((-1* (0SgSubj) OR (0SgObj) BARRIER VERB) OR (1* (0SgSubj) OR (0SgObj) BARRIER VERB)) ;

SELECT:noun_number_rule_4 NI_NID + (Pl) IF ((-1* (0PlSubj) OR (0PlObj) BARRIER VERB) OR (1* (0PlSubj) OR (0PlObj) BARRIER VERB)) ;

## ANIMACY DISAMBIGUATION

# Solve NA/NI and NAD/NID ambiguities
SELECT:noun_animacy_rule_1 NA_NAD IF ((-1* AN_ARGUMENT BARRIER VERB) OR (1* AN_ARGUMENT BARRIER VERB)) (NOT -1* INAN_ARGUMENT BARRIER VERB) (NOT 1* INAN_ARGUMENT BARRIER VERB) ;

SELECT:noun_animacy_rule_2 NI_NID IF ((-1* INAN_ARGUMENT BARRIER VERB) OR (1* INAN_ARGUMENT BARRIER VERB)) (NOT -1* AN_ARGUMENT BARRIER VERB) (NOT 1* AN_ARGUMENT BARRIER VERB) ;





### PRONOUNS - Rules to handle ambiguity of pronouns ###

## ANIMACY DISAMBIGUATION

# For now only found demonstrative case with following noun
SELECT:pronoun_animacy_rule_1 (PRONDem NA) IF (1 (NA)) (NOT 1 (NI)) ;
SELECT:pronoun_animacy_rule_2 (PRONDem NI) IF (1 (NI)) (NOT 1 (NA)) ;



### LEXICALIZATION - Where availabale, select lexicalized forms###

## PREVERBS
# Preverb/Prenoun rules, structure taken from Katherine Shmirler's Plains Cree parser (https://github.com/giellalt/lang-crk/blob/c82f485bf16cc98cee402e0023efe4a5b53ff60f/src/cg3/disambiguator.cg3#L1510) 
SELECT:lexicalize_PV_5 ("[^<]+[-].+[-].+[-].+[-].+[-][^>]+"r) IF (0 VERB OR ADV OR NOMINAL) ;
SELECT:lexicalize_PV_4 ("[^<]+[-].+[-].+[-].+[-][^>]+"r) IF (0 VERB OR ADV OR NOMINAL) ;
SELECT:lexicalize_PV_3 ("[^<]+[-].+[-].+[-][^>]+"r) IF (0 VERB OR ADV OR NOMINAL) ;
SELECT:lexicalize_PV_2 ("[^<]+[-].+[-][^>]+"r) IF (0 VERB OR ADV OR NOMINAL) ;
SELECT:lexicalize_PV_1 ("[^<]+[-][^>]+"r) IF (0 VERB OR ADV OR NOMINAL) ;

## DERIVATIONAL (Der/, Aug/, Dim, Pej, Reflex/, Recip/ tags)
LIST DERIVATIONAL = Der/magad Aug/magad Dim Pej Reflex/dizo Recip/di;
REMOVE DERIVATIONAL ;

# Prefer gichi- over chi-
REMOVE:gichi_over_chi (PVLex/chi) IF (0 (PVLex/gichi));

# Prefer Aug/magad over Der/magad
REMOVE:Aug_over_Der (Der/magad) IF (0 (Aug/magad));

# Prefer PV/gaa Pv/gii over duplicate Pv/gii 
SELECT:keep_gaa_gii (PVSub/gaa  PVTense/gii) ;

# TODO: run some tests to see if this works fully. Where to put this?
# Phonological lemma disambiguation 
# remove word ending in -wi (in favour of -∅ or -o)
REMOVE:remove_-wi ("(.*)wi"r) IF (0 ("$1"v) OR ("$1o"v));

# remove word starting with n- (in favour of ∅-)
REMOVE:remove_n- ("n(.*)"r) IF (0 ("$1"v));








### Argument Dependency - Rules to assign Verb - Noun/Pron dependency ###
### Current simplification: If noun can depend on more than 1 verb, set relation for the left-side verb

## LEFT SIDE DEPENDENCIES

## ANIMATE 3RD PERSON SUBJECT DEPENDENCY
SETRELATION:animate_subj_dep_1_L Dep_Subject TARGET (ProxSg) TO (-1* (3SgProxSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_2_L Dep_Subject TARGET (ProxPl) TO (-1* (3PlProxSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_3_L Dep_Subject TARGET (ObvSg) TO (-1* (3SgObvSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_4_L Dep_Subject TARGET (ObvPl) TO (-1* (3PlObvSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_5_L Dep_Subject TARGET (3Sg) TO (-1* SG_AN_SUBJECT BARRIER VERB);
SETRELATION:animate_subj_dep_6_L Dep_Subject TARGET (3Pl) TO (-1* PL_AN_SUBJECT BARRIER VERB);
SETRELATION:animate_subj_dep_7_L Dep_Subject TARGET AN_SPECIAL_PRON TO (-1* AN_SUBJECT BARRIER VERB);


## ANIMATE NON-3RD PERSON SUBJECT DEPENDENCY
SETRELATION:animate_subj_dep_8_L Dep_Subject TARGET (1Sg) TO (-1* (1SgSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_9_L Dep_Subject TARGET (2Sg) TO (-1* (2SgSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_10_L Dep_Subject TARGET (2Pl) TO (-1* (2PlSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_11_L Dep_Subject TARGET (Excl) TO (-1* (ExclSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_12_L Dep_Subject TARGET (Incl) TO (-1* (InclSubj) BARRIER VERB);


## ANIMATE 3RD PERSON OBJECT DEPENDENCY
SETRELATION:animate_obj_dep_1_L Dep_Object TARGET (ProxSg) TO (-1* (3SgProxObj) BARRIER VERB);
SETRELATION:animate_obj_dep_2_L Dep_Object TARGET (ProxPl) TO (-1* (3PlProxObj) BARRIER VERB);
SETRELATION:animate_obj_dep_3_L Dep_Object TARGET (ObvSg) TO (-1* (3SgObvObj) BARRIER VERB) ;
SETRELATION:animate_obj_dep_4_L Dep_Object TARGET (ObvPl) TO (-1* (3PlObvObj) BARRIER VERB) ;
SETRELATION:animate_obj_dep_5_L Dep_Object TARGET (3Sg) TO (-1* SG_AN_OBJECT BARRIER VERB);
SETRELATION:animate_obj_dep_6_L Dep_Object TARGET (3Pl) TO (-1* PL_AN_OBJECT BARRIER VERB);
SETRELATION:animate_subj_dep_7_L Dep_Subject TARGET AN_SPECIAL_PRON TO (-1* AN_OBJECT BARRIER VERB);

## ANIMATE NON-3RD PERSON OBJECT DEPENDENCY
SETRELATION:animate_obj_dep_8_L Dep_Object TARGET (1Sg) TO (-1* (1SgObj) BARRIER VERB);
SETRELATION:animate_obj_dep_9_L Dep_Object TARGET (2Sg) TO (-1* (2SgObj) BARRIER VERB);
SETRELATION:animate_obj_dep_10_L Dep_Object TARGET (2Pl) TO (-1* (2PlObj) BARRIER VERB);
SETRELATION:animate_obj_dep_11_L Dep_Object TARGET (Excl) TO (-1* (ExclObj) BARRIER VERB);
SETRELATION:animate_obj_dep_12_L Dep_Object TARGET (Incl) TO (-1* (InclObj) BARRIER VERB);


## INANIMATE SUBJECT DEPENDECY
SETRELATION:inanimate_subj_dep_1_L Dep_Subject TARGET (Sg) TO (-1* (0SgSubj) BARRIER VERB);
SETRELATION:inanimate_subj_dep_2_L Dep_Subject TARGET (Pl) TO (-1* (0PlSubj) BARRIER VERB);
SETRELATION:inanimate_subj_dep_3_L Dep_Subject TARGET AN_SPECIAL_PRON TO (-1* AN_SUBJECT BARRIER VERB);

## INANIMATE OBJECT DEPENDECY
SETRELATION:inanimate_subj_dep_1_L Dep_Object TARGET (Sg) TO (-1* (0SgObj) BARRIER VERB) ;
SETRELATION:inanimate_obj_dep_2_L Dep_Object TARGET (Pl) TO (-1* (0PlObj) BARRIER VERB) ;
SETRELATION:inanimate_obj_dep_3_L Dep_Object TARGET AN_SPECIAL_PRON TO (-1* AN_OBJECT BARRIER VERB);


## RIGHT SIDE DEPENDENCIES

## ANIMATE 3RD PERSON SUBJECT DEPENDENCY
SETRELATION:animate_subj_dep_1_R Dep_Subject TARGET (ProxSg) IF (NONE r:* (*)) TO (1* (3SgProxSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_2_R Dep_Subject TARGET (ProxPl) IF (NONE r:* (*)) TO (1* (3PlProxSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_3_R Dep_Subject TARGET (ObvSg) IF (NONE r:* (*)) TO (1* (3SgObvSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_4_R Dep_Subject TARGET (ObvPl) IF (NONE r:* (*)) TO (1* (3PlObvSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_5_R Dep_Subject TARGET (3Sg) IF (NONE r:* (*)) TO (1* SG_AN_SUBJECT BARRIER VERB);
SETRELATION:animate_subj_dep_6_R Dep_Subject TARGET (3Pl) IF (NONE r:* (*)) TO (1* PL_AN_SUBJECT BARRIER VERB);
SETRELATION:animate_subj_dep_7_R Dep_Subject TARGET AN_SPECIAL_PRON IF (NONE r:* (*)) TO (1* AN_SUBJECT BARRIER VERB);

## ANIMATE NON-3RD PERSON SUBJECT DEPENDENCY
SETRELATION:animate_subj_dep_8_R Dep_Subject TARGET (1Sg) IF (NONE r:* (*)) TO (1* (1SgSubj) BARRIER VERB) ;
SETRELATION:animate_subj_dep_9_R Dep_Subject TARGET (2Sg) IF (NONE r:* (*)) TO (1* (2SgSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_10_R Dep_Subject TARGET (2Pl) IF (NONE r:* (*)) TO (1* (2PlSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_11_R Dep_Subject TARGET (Excl) IF (NONE r:* (*)) TO (1* (ExclSubj) BARRIER VERB);
SETRELATION:animate_subj_dep_12_R Dep_Subject TARGET (Incl) IF (NONE r:* (*)) TO (1* (InclSubj) BARRIER VERB);

## ANIMATE 3RD PERSON OBJECT DEPENDENCY
SETRELATION:animate_obj_dep_1_R Dep_Object TARGET (ProxSg) IF (NONE r:* (*)) TO (1* (3SgProxObj) BARRIER VERB);
SETRELATION:animate_obj_dep_2_R Dep_Object TARGET (ProxPl) IF (NONE r:* (*)) TO (1* (3PlProxObj) BARRIER VERB);
SETRELATION:animate_obj_dep_3_R Dep_Object TARGET (ObvSg) IF (NONE r:* (*)) TO (1* (3SgObvObj) BARRIER VERB) ;
SETRELATION:animate_obj_dep_4_R Dep_Object TARGET (ObvPl) IF (NONE r:* (*)) TO (1* (3PlObvObj) BARRIER VERB) ;
SETRELATION:animate_obj_dep_5_R Dep_Object TARGET (3Sg) IF (NONE r:* (*)) TO (1* SG_AN_OBJECT BARRIER VERB);
SETRELATION:animate_obj_dep_6_R Dep_Object TARGET (3Pl) IF (NONE r:* (*)) TO (1* PL_AN_OBJECT BARRIER VERB);
SETRELATION:animate_obj_dep_7_R Dep_Object TARGET AN_SPECIAL_PRON IF (NONE r:* (*)) TO (1* AN_OBJECT BARRIER VERB);

## ANIMATE NON-3RD PERSON OBJECT DEPENDENCY
SETRELATION:animate_obj_dep_8_R Dep_Object TARGET (1Sg) IF (NONE r:* (*)) TO (1* (1SgObj) BARRIER VERB);
SETRELATION:animate_obj_dep_9_R Dep_Object TARGET (2Sg) IF (NONE r:* (*)) TO (1* (2SgObj) BARRIER VERB);
SETRELATION:animate_obj_dep_10_R Dep_Object TARGET (2Pl) IF (NONE r:* (*)) TO (1* (2PlObj) BARRIER VERB);
SETRELATION:animate_obj_dep_11_R Dep_Object TARGET (Excl) IF (NONE r:* (*)) TO (1* (ExclObj) BARRIER VERB);
SETRELATION:animate_obj_dep_12_R Dep_Object TARGET (Incl) IF (NONE r:* (*)) TO (1* (InclObj) BARRIER VERB);


## INANIMATE SUBJECT DEPENDECY
SETRELATION:inanimate_subj_dep_1_R Dep_Subject TARGET (Sg) IF (NONE r:* (*)) TO (1* (0SgSubj) BARRIER VERB);
SETRELATION:inanimate_subj_dep_2_R Dep_Subject TARGET (Pl) IF (NONE r:* (*)) TO (1* (0PlSubj) BARRIER VERB);
SETRELATION:inanimate_subj_dep_3_R Dep_Subject TARGET AN_SPECIAL_PRON IF (NONE r:* (*)) TO (1* INAN_SUBJECT BARRIER VERB);

## INANIMATE OBJECT DEPENDECY
SETRELATION:inanimate_subj_dep_1_R Dep_Object TARGET (Sg) IF (NONE r:* (*)) TO (1* (0SgObj) BARRIER VERB) ;
SETRELATION:inanimate_obj_dep_2_R Dep_Object TARGET (Pl) IF (NONE r:* (*)) TO (1* (0PlObj) BARRIER VERB) ;
SETRELATION:inanimate_obj_dep_3_R Dep_Object TARGET AN_SPECIAL_PRON IF (NONE r:* (*)) TO (1* INAN_OBJECT BARRIER VERB);



### Dependency, Demonstrative Pronoun rules
###
# NOT SURE IF WORKS YET
# If there is a Noun immediately following a PRONDem, remove any added relation, and set relation to following Noun
###
REMRELATION:dem_pronoun_cleanup  Dep_Subject TARGET(PRONDem NA) IF (1 NA_NAD) TO ((-1* VERB) OR (1* VERB)) ;
REMRELATION:dem_pronoun_cleanup  Dep_Object TARGET(PRONDem NA) IF (1 NA_NAD) TO ((-1* VERB) OR (1* VERB)) ;

SETRELATION:dem_pronoun_dep_1 Dep_Demonstrative TARGET(PRONDem NA) TO (1 NA_NAD) ; 
SETRELATION:dem_pronoun_dep_2 Dep_Demonstrative TARGET(PRONDem NI) TO (1 NI_NID) ; 
SETRELATION:dem_pronoun_dep_3 Dep_Demonstrative TARGET(PRONDem NA) IF (1 (NUM)) TO (2 NA_NAD) ; 
SETRELATION:dem_pronoun_dep_4 Dep_Demonstrative TARGET(PRONDem NI) IF (1 (NUM)) TO (2 NI_NID) ; 

### Oblique nominal argument rules
# NEED TO BE CHECKED
# If there is a loc noun before or after a verb, set argument relation
SETRELATION:obl_nominal_dep_L Dep_Obl TARGET NOMINAL + (Loc) TO (-1* VERB) ;
SETRELATION:obl_nominal_dep_R Dep_Obl TARGET NOMINAL + (Loc) IF (NONE r:* (*)) TO (1* VERB) ;


### Locative Adv rules
# NEED TO BE CHECKED
# IF there is no following loc noun, set obl relationship to verb (left-first)
SETRELATION:loc_adv_dep_L Dep_Obl TARGET (ADVLoc) TO (-1* VERB) ;
SETRELATION:loc_adv_dep_R Dep_Obl TARGET (ADVLoc) IF (NONE r:* (*)) TO (1* VERB) ;

# If there is a loc noun following a loc adv, set dependency to noun
REMRELATION:loc_adv_cleanup_1  Dep_Obl TARGET (ADVLoc) IF (1 NOMINAL + (Loc)) TO ((-1* VERB) OR (1* VERB)) ;
SETRELATION:loc_adv_dep_1 Dep_Prep TARGET (ADVLoc) TO (1 NOMINAL + (Loc)) ;

# If there is a loc adv following a loc adv belonging to special set, set prep dependency
REMRELATION:special_loc_cleanup_1  Dep_Obl TARGET SPECIAL_LOCS IF (1 (ADVLoc)) TO ((-1* VERB) OR (1* VERB)) ;
SETRELATION:special_loc_dep_1 Dep_Prep TARGET SPECIAL_LOCS TO (1 (ADVLoc)) ;

# If loc adv belongs to special set, set dependency to following verb if present
REMRELATION:special_loc_cleanup_2 Dep_Obl TARGET SPECIAL_LOCS IF (1 VERB) TO ((-1* VERB) OR (1* VERB)) ;
SETRELATION:special_loc_dep_2 Dep_Obl TARGET SPECIAL_LOCS TO (1 VERB) ;



### Temporal Adv rules
# SIMPLE VERSION - NEED TO BE CHECKED
# Set advmod relationship to verb (left-first)
SETRELATION:tmp_adv_dep_L Dep_AdvMod TARGET (ADVTmp) TO (-1* VERB) ;
SETRELATION:tmp_adv_dep_R Dep_AdvMod TARGET (ADVTmp) IF (NONE r:* (*)) TO (1* VERB) ;



### Manner Adv rules
# SIMPLE VERSION - NEED TO BE CHECKED
# Set advmod relationship to verb (left-first)
SETRELATION:man_adv_dep_L Dep_AdvMod TARGET (ADVMan) TO (-1* VERB) ;
SETRELATION:man_adv_dep_R Dep_AdvMod TARGET (ADVMan) IF (NONE r:* (*)) TO (1* VERB) ;


### Degree Adv rules
# SIMPLE VERSION - NEED TO BE CHECKED
# First set advmod relationship to other adverb (left-first)
SETRELATION:deg_adv_dep_L_1 Dep_AdvMod TARGET (AVDDeg) TO (-1 ADV) ;
SETRELATION:deg_adv_dep_R_1 Dep_AdvMod TARGET (AVDDeg) IF (NONE r:* (*)) TO (1 ADV) ;

# Fallback to advmod rel to verb
SETRELATION:deg_adv_dep_L_2 Dep_AdvMod TARGET (AVDDeg) IF (NONE r:* (*)) TO (-1* VERB) ;
SETRELATION:deg_adv_dep_R_2 Dep_AdvMod TARGET (AVDDeg) IF (NONE r:* (*)) TO (1* VERB) ;

### Negative Adv rules 
# Gaawiin - s relationship to closest neg verb (right-only)
SETRELATION:neg_adv_dep_gwn Dep_Neg TARGET ("gaawiin") TO (1* (Neg)) ;

SETRELATION:neg_adv_dep_gg Dep_Neg TARGET ("gego") TO (1* (Prb)) ;


### Relative clause ruls 
SET gaa_gii = (PVSub/gaa PVTense/gii') OR (PVSub/gaa PVTense/gii) ;
ADD:is_rc (RelCl) gaa_gii (IF NOT 0 (RelCl));

SETRELATION:relcl_dep_1 Dep_RelCl TARGET (Cnj 3SgProxSubj) TO (-1 (3SgProxPoss));




### Numeral rules
# Set nummod relation if noun immediately following
SETRELATION:nummod_dep_1 Dep_NumMod TARGET (NUM) TO (1 NOMINAL);


### Remove temporary tags
# REMOVE:rem_relcl (RelCl) ;

### Help with post-processing (Adding tags for CoNLL-U conversion)
ADD:Is_Noun (NOUN) TARGET NOMINAL IF (NOT 0 PRON) (NOT 0 (NOUN)) ;
ADD:Is_Det (DET) TARGET (PRONDem) IF (1 (NOUN)) (NOT 0 (DET)) ;
ADD:Is_Pron (PRON) TARGET PRON IF (NOT 0 (DET)) (NOT 0 (PRON)) ;
ADD:Is_Verb (VERB) TARGET VERB (NOT 0 (VERB)) ;
ADD:Is_Adv (ADV) TARGET ADV (NOT 0 (ADV)) ;
ADD:Is_Part (PART) TARGET PART (NOT 0 (PART));
ADD:Is_Intj (INTJ) TARGET (PCInterj) (NOT 0 (INTJ));